      "action": "Implement",
      "detail": "state-space search algorithms to solve pathfinding problems.",
      "blooms" : 3
    },
    {
      "num": 2,
      "action": "Model",
      "detail": "analogical reasoning in agents by designing them to map past solutions onto new problems.",
      "blooms" : 4
    },
    {
      "num": 3,
      "action": "Evaluate",
      "detail": "how metacognitive feedback loops allow agents to correct their own errors.",
      "blooms" : 5
    },
    {
      "num": 4,
      "action": "Design",
      "detail": "an integrated cognitive agent that combines search, memory, and reasoning.",
