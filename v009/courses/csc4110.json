  "prereq": "",
  "catalog": "In this course, students will explore the Internet of Things using a combination of lecture and laboratory practice. Topics include, but are not limited to, IoT Architectures, Sensors and Microcontrollers, Synthetic Sensors, Digital and Analog Electronics, Python and C programming for IoT, Sampling Strategies, Connectivity and Networks, Data Analysis and Data Management. In the laboratory component, students will design and build IoT solutions according to design requirements provided by the instructor.",
  "goals": [
    {
      "num": 1,
      "action": "Understand",
      "detail": "the architectures and devices which comprise Internet of Things systems.",
      "blooms": 2
    },
    {
      "num": 2,
      "action": "Analyze",
      "detail": "the structural alignment between physical processing constraints and sensor data throughput in real-timme edge applications.",
      "blooms": 4
    },
    {
      "num": 3,
      "action": "Develop",
      "detail": "IoT systems by combining physical sensors, actuators, and microcontroller-integrated software and hardware components.",
      "blooms": 6
    },
    {
      "num": 4,
      "action": "Program",
      "detail": "edge devices to collect, serialize, and transmit operational data across a local network to coordinate system behavior.",
      "blooms": 4
    },
    {
      "num": 5,
      "action": "Configure",
      "detail": "IoT system architectures, distinguishing between edge node operations and a central hub.",
      "blooms": 4
    },
    {
      "num": 6,
      "action": "Validate",
      "detail": "collaborative, network IoT system design requirements through physical testing.",
      "blooms": 5
    }
  ],
