        {
            "num": 1,
            "action": "Develop",
            "detail": "knowledge of a basic computer system architecture."
        },
        {
            "num": 2,
            "action": "Develop",
            "detail": "a problem solving methodology and apply it to writing programs in C#."
        },
        {
            "num": 3,
            "action": "Acquire",
            "detail": "an understanding of the basic C# language concepts."
        },
        {
            "num": 4,
            "action": "Develop",
            "detail": "your ability to use a C# editor and debugger."
        }
    ],
