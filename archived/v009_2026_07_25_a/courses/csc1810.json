    "assess": [
        {
            "name": "Quizzes",
            "description": "At the end of each week, a short in-class quiz on the prior week's reading and concepts.",
            "percentage": "10",
            "colorbg": "#6facde",
            "colorfont": "#1f1f1f"
        },
        {
            "name": "Progress Reports",
            "description": "Weekly written update on project status: what was attempted, what works, what doesn't, what's next.",
            "percentage": "10",
            "colorbg": "#de716f",
            "colorfont": "#1f1f1f"
        },
        {
            "name": "Presentation 1: The Pitch",
            "description": "Students pitch their semester project: what it is, why it interests them, and which C# concepts they expect to use.",
            "percentage": "15",
            "colorbg": "#decb6f",
            "colorfont": "#1f1f1f"
        },
        {
            "name": "Presentation 2: The Progress",
            "description": "Students demonstrate working C# code for at least one core feature and explain design decisions made so far.",
            "percentage": "25",
            "colorbg": "#decb6f",
            "colorfont": "#1f1f1f"
        },
        {
            "name": "Presentation 3: The Final Form",
            "description": "Full project demonstration, code walkthrough, and oral exam. Questions may cover any part of the code.",
            "percentage": "40",
            "colorbg": "#decb6f",
            "colorfont": "#1f1f1f"
        }
    ],
    "instructions": {
        "presentations": [
            {
                "id": "pitch",
                "name": "Presentation 1: The Pitch",
                "weight": "15%",
                "slots": "~5 minutes per student",
                "sections": [
                    {
                        "heading": "What to Cover",
                        "items": [
                            "What is your project? Describe it in one or two sentences a non-programmer could understand.",
                            "Why did you choose it? What genuinely interests you about building this?",
                            "What will the program do? Walk through a plausible user interaction from start to finish.",
                            "Which C# concepts do you expect to use? Name at least two (e.g., loops, methods, arrays, classes).",
                            "What is the hardest part going to be? You do not need to know the answer yet \u2014 you just need to have thought about it."
                        ]
                    },
                    {
                        "heading": "Format",
                        "items": [
                            "Spoken presentation only \u2014 no slides required, though you may use them if you want.",
                            "You may bring notes or an outline, but do not read directly from them.",
                            "You are not graded on polish. You are graded on whether you have thought seriously about what you are building."
                        ]
                    },
                    {
                        "heading": "What Makes It Strong",
                        "items": [
                            "A specific, concrete project rather than a vague idea ('a console inventory system for a small shop' beats 'some kind of data program').",
                            "Evidence that you have considered scope \u2014 that the project is doable in a semester, not just aspirational.",
                            "Honest engagement with the hard parts."
                        ]
                    }
                ]
            },
            {
                "id": "progress",
                "name": "Presentation 2: The Progress",
                "weight": "25%",
                "slots": "~8 minutes per student",
                "sections": [
                    {
                        "heading": "What to Cover",
                        "items": [
                            "Demonstrate running code. Something must work \u2014 it does not have to be complete.",
                            "Explain the structure of your program so far: what files, classes, or methods you have written and what each one does.",
                            "Walk through one piece of code in detail. Show the actual source and explain what it does line by line (or block by block).",
                            "What has changed since your Pitch? Did the scope grow, shrink, or shift direction?",
                            "What is left to build? Be specific about your remaining tasks.",
                            "What is the hardest unresolved problem you are facing?"
                        ]
                    },
                    {
                        "heading": "Format",
                        "items": [
                            "You must share your screen (or project your screen) and run the program live.",
                            "Slides are optional and generally less useful here than just showing the code and the program.",
                            "Prepare for follow-up questions about your code."
                        ]
                    },
                    {
                        "heading": "What Makes It Strong",
                        "items": [
                            "Working code, even if minimal. A program that does one thing reliably is better than a broken program that attempts everything.",
                            "Fluent explanation of your own code \u2014 you should be able to point to any method you wrote and explain it.",
                            "A realistic accounting of what is left. Overconfidence about remaining work is a warning sign."
                        ]
                    }
                ]
            },
            {
                "id": "final",
                "name": "Presentation 3: The...Perfection?",
                "weight": "40%",
                "slots": "~12 minutes per student",
                "sections": [
                    {
                        "heading": "What to Cover",
                        "items": [
                            "Full demonstration of the completed project. Run it from start to finish.",
                            "Walk through the overall architecture: how is the code organized into classes and methods, and why?",
                            "Deep walkthrough of the most technically interesting part of your code.",
                            "Reflection: what did you learn? What would you do differently? What would you add if you had more time?",
                            "Oral exam component: the instructor will ask questions about your code. Questions may target any method, class, or design choice."
                        ]
                    },
                    {
                        "heading": "Format",
                        "items": [
                            "Live demo is required. Have a backup plan (screenshots, recorded video) in case of technical failure.",
                            "Code must be available and readable during the presentation.",
                            "The oral exam is part of the grade. Be prepared to explain, modify, or reason about any part of your code on the spot."
                        ]
                    },
                    {
                        "heading": "What Makes It Strong",
                        "items": [
                            "A polished, working program that demonstrates genuine learning over the semester.",
                            "Deep ownership of the code \u2014 you wrote it, you understand it, you can defend every part of it.",
                            "Thoughtful reflection that goes beyond 'it was hard but I figured it out.'"
                        ]
                    },
                    {
                        "heading": "Oral Exam",
                        "items": [
                            "The instructor will ask you to explain specific lines or blocks of code.",
                            "You may be asked 'what would happen if you changed X?' or 'why did you use a class here instead of a method?'",
                            "There are no trick questions. The goal is to confirm that the code in front of us is genuinely yours and that you understand it."
                        ]
                    }
                ]
            }
        ],
        "progress_reports": {
            "description": "Each week you will submit a short written update on your semester project. These are low-stakes check-ins meant to keep you moving and to give the instructor early warning if something has gone wrong.",
            "format": [
                "Approximately one paragraph \u2014 three to six sentences is typical.",
                "Written in plain prose, not bullet points.",
                "Submitted before the start of class on Friday."
            ],
            "prompts": [
                "What did you work on this week?",
                "What actually works right now?",
                "What did you attempt that did not work, and do you know why?",
                "What do you plan to work on next week?"
            ],
            "grading": "Progress reports are graded on completion and honesty, not on how much you accomplished. A report that says 'I tried to implement X, got stuck on Y, and plan to ask about it Monday' is a full-credit report. A report that says 'everything is going great' when you have written no code is not."
        },
        "semester_project": {
            "description": "Your semester project is a C# program of your own design. You will conceive it, build it, and present it three times over the course of the semester. The project is the spine of the course \u2014 everything else is preparation for it.",
            "requirements": [
                "The program must be written in C# using .NET.",
                "It must be your own original work \u2014 you may use libraries, but the logic must be yours.",
                "It must demonstrate at least three of the major topics from the course (e.g., methods, arrays, classes, inheritance).",
                "It must be interactive in some way \u2014 it should respond to user input or produce meaningful output.",
                "It must be something you actually want to build."
            ],
            "scope_guidance": [
                "A good project takes about 150\u2013300 lines of well-organized code for a beginner.",
                "It should be more complex than a homework problem but not a commercial application.",
                "If your idea seems too small, add a feature. If it seems too large, cut a feature.",
                "When in doubt, start small and expand \u2014 it is much easier to add scope than to recover from being overwhelmed."
            ],
            "ideas": [
                "A console-based game (text adventure, quiz, simple RPG combat)",
                "An inventory or record-keeping system with classes",
                "A simulation of something you find interesting (using classes to model agents or objects)",
                "A gradebook or scheduler tool",
                "A utility that reads data from a file and produces a report",
                "Something game-adjacent \u2014 a map, a character sheet, a loot table \u2014 for students interested in the Game Dev minor"
            ]
        }
    }
}